# autoessay — API keys
#
# The MVP needs exactly one key: an OpenRouter key gives access to both models
# the pipeline uses (a fast writer and a stronger editor). Get one at
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Optional direct providers. These must also be enabled in
# config/providers.yaml (they are commented out there by default).
# DEEPSEEK_API_KEY=sk-...
# ZAI_API_KEY=...
# ANTHROPIC_API_KEY=sk-ant-...
