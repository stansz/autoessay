# autoessay — API keys for the Rust implementation
#
# Copy this file to `.env` (in this directory or the repo root) and set one key.
# The binary loads `.env` automatically; real environment variables win over it.
#
# The MVP needs exactly one key: an OpenRouter key gives access to both models
# the pipeline uses (a fast writer and a stronger editor).
OPENROUTER_API_KEY=sk-or-v1-...

# Optional: used only in the User-Agent for Crossref's polite pool
# CROSSREF_EMAIL=you@example.com

# Optional direct providers. These must also be enabled in
# crates/autoessay-providers/config/providers.yaml (commented out by default).
# DEEPSEEK_API_KEY=sk-...
# ZAI_API_KEY=...
# ANTHROPIC_API_KEY=sk-ant-...
